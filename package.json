{
  "name": "slackzilla",
  "version": "v0.8.5-beta",
  "description": "slackatron mega 1x1x1x1 edition",
  "main": "src/bot.js",
  "scripts": {
    "start": "node src/bot.js",
    "dev": "node src/bot.js",
    "generate-manifest": "node scripts/generateManifest.js",
    "validate-manifest": "ajv validate -s schemas/manifest.schema.json -d manifest.json",
    "validate-commands": "ajv validate -s schemas/command.schema.json -d src/data/commands.json",
    "cmd-stats": "node scripts/stats.js",
    "build:pages": "node scripts/build-pages.js"
  },
  "keywords": [
    "slack", "bot", "slackbot", "slack-bot", "slack-app",
    "slack-api", "slack-bolt", "slackzilla", "chatbot",
    "automation", "developer-tools", "devtools", "utilities",
    "free-api", "api", "api-server", "rest-api", "web-api",
    "webhooks", "github", "github-api", "octokit","monitoring",
    "server-monitoring", "server-stats", "dashboard", "admin-dashboard",
    "system-monitoring", "uptime-monitoring", "logging", "logger",
    "metrics", "analytics", "health-check", "status-page",
    "self-hosted", "nodejs", "node", "javascript", "backend",
    "automation-tools", "open-source", "developer-utility"
  ],
  "author": "@rylvion",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "@openrouter/sdk": "^1.2.4",
    "@slack/bolt": "^4.7.3",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "octokit": "^5.0.5",
    "sodium-native": "^5.1.0"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-cli": "^5.0.0",
    "ajv-formats": "^3.0.1",
    "clean-css": "^5.3.3",
    "html-minifier-terser": "^7.2.0",
    "terser": "^5.49.0"
  }
}
