{
  "name": "slackzilla",
  "version": "v0.9.3-beta",
  "description": "slackatron mega 1x1x1x1 edition",
  "main": "bot/bot.js",
  "scripts": {
    "start": "npm run build && npm run lint && concurrently --names \"BOT,SERVER\" \"npm run bot\" \"node server/server.js\"",
    "bot": "node bot/bot.js",
    "server": "node server/server.js",
    "dev": "vite --open --config server/client/vite.config.mjs",
    "build": "vite build --config server/client/vite.config.mjs",
    "preview": "vite preview --config server/client/vite.config.mjs",
    "build:preview": "vite build --open --config server/client/vite.config.mjs && vite preview --config server/client/vite.config.mjs",
    "lint": "eslint ./server/client",
    "generate-manifest": "node scripts/generateManifest.js",
    "validate-manifest": "ajv validate -s schemas/manifest.schema.json -d manifest.json",
    "validate-commands": "ajv validate -s schemas/command.schema.json -d bot/data/commands.json",
    "cmd-stats": "node scripts/stats.js"
  },
  "keywords": [
    "slack",
    "bot",
    "slackbot",
    "slack-bot",
    "slack-app",
    "slack-api",
    "slack-bolt",
    "slackzilla",
    "chatbot",
    "automation",
    "developer-tools",
    "devtools",
    "utilities",
    "free-api",
    "api",
    "api-server",
    "rest-api",
    "web-api",
    "webhooks",
    "github",
    "github-api",
    "octokit",
    "monitoring",
    "server-monitoring",
    "server-stats",
    "dashboard",
    "admin-dashboard",
    "system-monitoring",
    "uptime-monitoring",
    "logging",
    "logger",
    "metrics",
    "analytics",
    "status-page",
    "self-hosted",
    "nodejs",
    "node",
    "javascript",
    "backend",
    "automation-tools",
    "open-source",
    "developer-utility",
    "vite",
    "vite-app",
    "react",
    "react-app",
    "react-dashboard",
    "react-admin",
    "react-utilities",
    "sse",
    "event-stream",
    "event-streaming",
    "commands",
    "command-handler",
    "ai-assistant",
    "ai",
    "RAG",
    "retrieval-augmented-generation"
  ],
  "author": "@rylvion",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "@slack/bolt": "^4.7.3",
    "@vitejs/plugin-react": "^6.0.4",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "chart.js": "^4.5.1",
    "dotenv": "^17.4.2",
    "octokit": "^5.0.5",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.2",
    "sodium-native": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "ajv": "^8.17.1",
    "ajv-cli": "^5.0.0",
    "ajv-formats": "^3.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "vite": "^8.2.0"
  }
}
