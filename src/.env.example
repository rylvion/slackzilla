# remove the .example from the file name and fill in the values to use the bot

SLACK_BOT_TOKEN=xoxb-...                                    # Bot User OAuth Token (from OAuth & Permissions)
SLACK_APP_TOKEN=xapp-...                                    # App-Level Token (from basic Information to App-Level Tokens)
SLACK_SIGNING_SECRET=...                                    # Signing Secret (from basic information)
AI_API_KEY=...                                              # (not needed)
AI_MODEL=openai/gpt-oss-20b:free                            # (not needed)
AI_URL=https://ai.hackclub.com/proxy/v1/chat/completions    # (not needed)