WEBHOOK_SECRET=replace_with_a_random_secret # do `openssl rand -hex 32` on linux/wsl or on windows do `[Convert]::ToHexString((1..32 | ForEach-Object { Get-Random -Maximum 256 })).ToLower()`
PORT=9000
PROJECT_DIR=/root/projs/slackzilla # replace with the directory of this
SERVICE_NAME=slackzilla # replace with the name of service if different
BOT_SERVICE_NAME=slackzilla # bot service to control from the dashboard
BRANCH=main # branch to deploy from
REPO_URL=https://github.com/rylvion/slackzilla.git # change this to your repo
ADMIN_PASSWORD_HASH=pbkdf2$sha512$600000$replace_with_salt$replace_with_hash # use a pbkdf2 hash in the format pbkdf2$algorithm$iterations$salt$hash with the command /sz-hash pbkdf2 sha512 600000 mysalt mypassword
ADMIN_SESSION_SECRET=replace_with_a_random_secret # session signing secret for the admin dashboard
COOKIE_SECURE=false # set to true when the dashboard is behind https