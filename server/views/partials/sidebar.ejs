<aside class="sidebar">
    <div class="sidebar-title">NAVIGATION</div>
    <nav>
        <a class="<%= active === 'home' ? 'active' : '' %>" href="/">Home</a>
        <a class="<%= active === 'status' ? 'active' : '' %>" href="/status">Uptime</a>
        <a class="<%= active === 'logs' ? 'active' : '' %>" href="/logs">Logs</a>
        <a class="<%= active === 'api' ? 'active' : '' %>" href="/api">API</a>
        <a class="<%= active === 'docs' ? 'active' : '' %>" href="/docs">Docs</a>
        <a class="<%= active === 'admin' ? 'active' : '' %>" href="/admin">Admin</a>
    </nav>

    <div class="sidebar-footer">
        <div class="footer-title">STATUS</div>
        <% const sidebarStatus = state?.botOnline || state?.summary?.botOnline || 'offline' %>
        <div class="status">
            <span class="<%= ['active', 'online'].includes(String(sidebarStatus).toLowerCase()) ? 'dot' : 'dot dot--red' %>"></span>
            <%= sidebarStatus %>
        </div>
    </div>
</aside>
