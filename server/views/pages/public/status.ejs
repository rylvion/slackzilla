<section class="panel">
    <h2>UPTIME</h2>
    <div class="status-line">
        <span class="<%= ['active', 'online'].includes(String(status.botOnline).toLowerCase()) ? 'dot' : 'dot dot--red' %>"></span>
        <%= status.botOnline %>
    </div>
</section>

<section class="panel">
    <h2>SYSTEM</h2>
    <table>
        <tr><td>Uptime</td><td data-field="uptime"><%= status.uptimeText %></td></tr>
        <tr><td>Node.js</td><td data-field="nodeVersion"><%= status.nodeVersion %></td></tr>
        <tr><td>Platform</td><td data-field="platform"><%= status.platform %></td></tr>
        <tr><td>Branch</td><td data-field="branch"><%= status.branch %></td></tr>
        <tr><td>Commit</td><td data-field="commit"><%= status.commit %></td></tr>
        <tr><td>Last Commit</td><td data-field="lastCommitAt"><%= status.lastCommitAtText %></td></tr>
    </table>
</section>

<section class="panel">
    <h2>STATISTICS</h2>
    <table>
        <tr><td>Memory</td><td data-field="resources"><%= status.memoryText %></td></tr>
        <tr><td>RSS</td><td data-field="rss"><%= status.rssText %></td></tr>
        <tr><td>CPU</td><td data-field="cpu"><%= status.cpuText %></td></tr>
        <tr><td>Load</td><td data-field="load"><%= status.loadText %></td></tr>
        <tr><td>Deploy Status</td><td data-field="deployment"><%= status.deploymentStatus %></td></tr>
        <tr><td>Last Deploy</td><td><%= status.lastDeploymentText %></td></tr>
    </table>
</section>

<section class="panel">
    <h2>TOP COMMANDS</h2>
    <div id="status-command-stats">
        <table>
            <tr><td>Command</td><td>Count</td><td>Last user</td><td>Last used</td></tr>
            <% (commandStats || []).slice(0, 8).forEach(item => { %>
                <tr>
                    <td><%= item.name %></td>
                    <td><%= item.count %></td>
                    <td><%= item.lastUser || 'unknown' %></td>
                    <td><%= formatDate(item.lastUsedAt) %></td>
                </tr>
            <% }) %>
            <% if (!(commandStats || []).length) { %>
                <tr><td colspan="4">No command usage recorded yet.</td></tr>
            <% } %>
        </table>
    </div>
</section>

<section class="panel">
    <h2>DEPLOYMENT SNAPSHOT</h2>
    <table>
        <tr><td>Commit</td><td><%= status.commit %></td></tr>
        <tr><td>Branch</td><td><%= status.branch %></td></tr>
        <tr><td>Last commit</td><td><%= status.lastCommitAtText %></td></tr>
        <tr><td>Result</td><td><%= status.lastDeploymentResult || 'unknown' %></td></tr>
    </table>
</section>
