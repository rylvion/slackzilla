<section class="panel">
    <h2>API OVERVIEW</h2>
    <p>The API is split into separate route modules for status, logs, feedback, admin summary, and control actions.</p>
    <p>All JSON endpoints return a predictable envelope: <span class="mono">ok: true</span> on success and <span class="mono">ok: false</span> with a stable error code on failure.</p>
</section>

<section class="panel">
    <h2>ENDPOINTS</h2>

    <div class="endpoint">
        <div class="endpoint-header">
            <span class="method get">GET</span>
            <span class="endpoint-url">/api/status</span>
        </div>
        <table>
            <tr><td>Purpose</td><td>Return the current bot and server status snapshot.</td></tr>
            <tr><td>Authentication</td><td>Public</td></tr>
            <tr><td>Request</td><td><pre>No request body.</pre></td></tr>
            <tr><td>Response</td><td><pre>{
  "ok": boolean,
  "data": {
    "botOnline": string,
    "uptimeText": string,
    "nodeVersion": string,
    "platform": string,

    "commit": string,
    "branch": string,
    "lastCommitAtText": string,
    "lastDeploymentText": string,
    "deploymentStatus": string,

    "lastDeploymentOutput": string,

    "rssText": string,
    "cpuText": string,
    "memoryText": string,
    "loadText": string,

    "lastDeploymentAt": string, // ISO timestamp
    "lastDeploymentCommit": string,
    "lastDeploymentResult": string,

    "systemTotalMemory": number,
    "systemFreeMemory": number
  }
}</pre></td></tr>
        </table>
    </div>

    <div class="endpoint">
        <div class="endpoint-header">
            <span class="method get">GET</span>
            <span class="endpoint-url">/api/logs</span>
        </div>
        <table>
            <tr><td>Purpose</td><td>Return the current log snapshot and line count.</td></tr>
            <tr><td>Authentication</td><td>Public</td></tr>
            <tr><td>Request</td><td><pre>No request body.</pre></td></tr>
            <tr><td>Response</td><td><pre>{
  "ok": true,
  "data": {
    "size": number,
    "lines": [string] // contains multiple lines of log text, each line is a string
  }
}</pre></td></tr>
        </table>
    </div>

    <div class="endpoint">
        <div class="endpoint-header">
            <span class="method get">GET</span>
            <span class="endpoint-url">/api/admin/summary</span>
        </div>
        <table>
            <tr><td>Purpose</td><td>Return the authenticated admin dashboard snapshot.</td></tr>
            <tr><td>Authentication</td><td>Admin session cookie</td></tr>
            <tr><td>Request</td><td><pre>Requires an authenticated admin cookie.</pre></td></tr>
            <tr><td>Response</td><td><pre>{
  "ok": true,
  "data": {
    "status": { "botOnline": "online" },
    "feedback": [],
    "commandStats": [
        {
            "name": string,
            "count": number,
            "lastUsedAt": string, // ISO timestamp
            "lastUser": string,
            "lastUserId": string
        }
    ]
  }
}</pre></td></tr>
        </table>
    </div>

    <div class="endpoint">
        <div class="endpoint-header">
            <span class="method get">GET</span>
            <span class="endpoint-url">/api/admin/feedback</span>
        </div>
        <table>
            <tr><td>Purpose</td><td>Return a filtered list of feedback entries.</td></tr>
            <tr><td>Authentication</td><td>Admin session cookie</td></tr>
            <tr><td>Request</td><td><pre>Optional query parameters: q, status.</pre></td></tr>
            <tr><td>Response</td><td><pre>{
  "ok": true,
  "data": {
    "feedback": []
  }
}</pre></td></tr>
        </table>
    </div>

    <div class="endpoint">
        <div class="endpoint-header">
            <span class="method get">GET</span>
            <span class="endpoint-url">/api/admin/feedback/:id</span>
        </div>
        <table>
            <tr><td>Purpose</td><td>Return a single feedback entry by ID.</td></tr>
            <tr><td>Authentication</td><td>Admin session cookie</td></tr>
            <tr><td>Request</td><td><pre>Replace :id with the feedback ID from the inbox.</pre></td></tr>
            <tr><td>Response</td><td><pre>{
  "ok": true,
  "data": {
    "feedback": {
        "id": string,
        "status": string,
        "userId": string,
        "username": string,
        "message": string,
        "timestamp": string, // ISO timestamp
        "status": string,
        "response": string,
        "responseSentAt": string, // ISO timestamp
        "responseError": null,
        "updatedAt": string // ISO timestamp
    }
  }
}</pre></td></tr>
        </table>
    </div>

    <div class="endpoint">
        <div class="endpoint-header">
            <span class="method post">POST</span>
            <span class="endpoint-url">/api/admin/feedback/:id</span>
        </div>

        <table>
            <tr>
                <td>Purpose</td>
                <td>
                    Performs actions on a feedback entry including marking as read,
                    marking as unread, deleting feedback, or sending a Slack DM response.
                </td>
            </tr>

            <tr>
                <td>Authentication</td>
                <td>Admin session cookie + valid CSRF token</td>
            </tr>

            <tr>
                <td>Headers</td>
                <td>
    <pre>x-csrf-token: &lt;csrf token&gt;
Content-Type: application/json</pre>
                </td>
            </tr>

            <tr>
                <td>Path Parameters</td>
                <td>
    <pre>:id = feedback UUID

Example:
a71c28fa-863d-447e-84a3-627bd5120572</pre>
                </td>
            </tr>

            <tr>
                <td>Supported Actions</td>
                <td>
    <pre>read
unread
delete
respond</pre>
                </td>
            </tr>

            <tr>
                <td>Mark as Read</td>
                <td>
    <pre>{
    "action": "read"
}</pre>
                </td>
            </tr>

            <tr>
                <td>Mark as Unread</td>
                <td>
    <pre>{
    "action": "unread"
}</pre>
                </td>
            </tr>

            <tr>
                <td>Delete Feedback</td>
                <td>
    <pre>{
    "action": "delete"
}</pre>
                </td>
            </tr>

            <tr>
                <td>Send Response</td>
                <td>
    <pre>{
    "action": "respond",
    "response": "Thanks for the report"
}</pre>
                </td>
            </tr>

            <tr>
                <td>Response Limits</td>
                <td>
                    Response text is limited to 4000 characters.
                </td>
            </tr>

            <tr>
                <td>Successful Response</td>
                <td>
    <pre>{
"ok": true,
"data": {
    "feedback": {
    "id": string,
    "status": "responded", // 3 options: "unread", "read", "responded"
    "response": "Thanks for the report",
    "responseSentAt": string, // ISO timestamp
    "updatedAt": string // ISO timestamp
    }
}
    }</pre>
                </td>
            </tr>

            <tr>
                <td>Error Response</td>
                <td>
    <pre>{
    "ok": false,
    "code": "CSRF_INVALID",
    "error": "invalid csrf token"
}</pre>
                </td>
            </tr>

            <tr>
                <td>Possible Error Codes</td>
                <td>
                    <pre>AUTH_REQUIRED
CSRF_INVALID
BAD_REQUEST
INVALID_FEEDBACK_ACTION
FEEDBACK_NOT_FOUND
FEEDBACK_DM_FAILED</pre>
                </td>
            </tr>

            <tr>
                <td>Notes</td>
                <td>
                    The <code>respond</code> action opens a Slack DM with the
                    original user and sends the response message automatically.
                    Successful responses update the feedback status to
                    <code>responded</code>.
                </td>
            </tr>
        </table>
    </div>

    <div class="endpoint">
        <div class="endpoint-header">
            <span class="method post">POST</span>
            <span class="endpoint-url">/api/admin/control</span>
        </div>

        <table>
            <tr>
                <td>Purpose</td>
                <td>
                    Trigger bot control, deployment, status, and log management
                    actions from the admin dashboard.
                </td>
            </tr>

            <tr>
                <td>Authentication</td>
                <td>Admin session cookie + valid CSRF token</td>
            </tr>

            <tr>
                <td>Headers</td>
                <td>
<pre>Content-Type: application/json
x-csrf-token: &lt;csrf token&gt;</pre>
                </td>
            </tr>

            <tr>
                <td>Request Body</td>
                <td>
                    A JSON object containing an <code>action</code> field.
                </td>
            </tr>

            <tr>
                <td>Supported Actions</td>
                <td>
    <pre>start
stop
restart
redeploy
refresh
refresh-status
refresh-logs</pre>
                </td>
            </tr>

            <tr>
                <td>Start Bot</td>
                <td>
    <pre>{
        "action": "start"
    }</pre>
                    Starts the Slackzilla systemd service.
                </td>
            </tr>

            <tr>
                <td>Stop Bot</td>
                <td>
    <pre>{
    "action": "stop"
}</pre>
                    Stops the Slackzilla systemd service.
                </td>
            </tr>

            <tr>
                <td>Restart Bot</td>
                <td>
    <pre>{
    "action": "restart"
}</pre>
                    Restarts the Slackzilla systemd service.
                </td>
            </tr>

            <tr>
                <td>Redeploy</td>
                <td>
    <pre>{
    "action": "redeploy"
}</pre>
                    Runs the server deployment script, updates the deployment
                    state, refreshes the runtime status, and broadcasts the
                    deployment result to connected admin clients.
                </td>
            </tr>

            <tr>
                <td>Refresh</td>
                <td>
    <pre>{
    "action": "refresh"
}</pre>
                    Refreshes the runtime status and broadcasts an updated
                    admin dashboard summary.
                </td>
            </tr>

            <tr>
                <td>Refresh Status</td>
                <td>
    <pre>{
    "action": "refresh-status"
}</pre>
                    Refreshes the runtime status and returns the updated status.
                </td>
            </tr>

            <tr>
                <td>Refresh Logs</td>
                <td>
    <pre>{
    "action": "refresh-logs"
}</pre>
                    Refreshes the server's log state and returns the current
                    log snapshot size.
                </td>
            </tr>

            <tr>
                <td>Response: Start / Stop / Restart</td>
                <td>
    <pre>{
    "ok": true,
    "data": {
        "action": "restart"
    }
}</pre>
                </td>
            </tr>

            <tr>
                <td>Response: Refresh Status</td>
                <td>
    <pre>{
    "ok": true,
    "data": {
        "status": {
            "botOnline": true,
            "uptimeText": "...",
            "nodeVersion": "...",
            "platform": "...",
            "commit": "...",
            "branch": "main"
        }
    }
}</pre>
                </td>
            </tr>

            <tr>
                <td>Response: Refresh</td>
                <td>
    <pre>{
    "ok": true,
    "data": {
        "status": {
            "botOnline": true
        }
    }
}</pre>
                </td>
            </tr>

            <tr>
                <td>Response: Refresh Logs</td>
                <td>
    <pre>{
    "ok": true,
    "data": {
        "size": 12345
    }
}</pre>
                </td>
            </tr>

            <tr>
                <td>Response: Redeploy</td>
                <td>
    <pre>{
    "ok": true,
    "data": {
        "state": {
            "status": "success",
            "lastDeploymentAt": "...",
            "lastDeploymentCommit": "...",
            "lastDeploymentOutput": [],
            "lastDeploymentResult": "success"
        }
    }
}</pre>
                </td>
            </tr>

            <tr>
                <td>Error: Invalid Action</td>
                <td>
    <pre>{
    "ok": false,
    "code": "UNKNOWN_CONTROL_ACTION",
    "error": "unknown control action"
}</pre>
                </td>
            </tr>

            <tr>
                <td>Error: CSRF</td>
                <td>
    <pre>{
    "ok": false,
    "code": "CSRF_INVALID",
    "error": "invalid csrf token"
}</pre>
                </td>
            </tr>

            <tr>
                <td>Error: Action Failed</td>
                <td>
    <pre>{
    "ok": false,
    "code": "CONTROL_ACTION_FAILED",
    "error": "..."
}</pre>
                </td>
            </tr>

            <tr>
                <td>Notes</td>
                <td>
                    <code>start</code>, <code>stop</code>, and <code>restart</code>
                    operate on the configured Slackzilla systemd service.
                    <code>redeploy</code> executes the server deployment script.
                    <code>refresh</code>, <code>refresh-status</code>, and
                    <code>refresh-logs</code> are dashboard synchronisation
                    operations and do not restart the bot.
                </td>
            </tr>
        </table>
    </div>
</section>

<section class="panel">
    <h2>ERRORS</h2>
    <p>Errors follow the same shape everywhere:</p>
    <pre><%= JSON.stringify({ ok: false, error: "Feedback not found", code: "FEEDBACK_NOT_FOUND" }, null, 2) %></pre>
</section>
