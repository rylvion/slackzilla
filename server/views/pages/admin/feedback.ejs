<div id="admin-action-status" class="action-status">Ready.</div>

<section class="panel">
    <h2>FEEDBACK INBOX</h2>
    <form id="feedback-filters" class="toolbar">
        <input id="feedback-search" class="input" name="q" value="<%= query %>" placeholder="Search feedback" />
        <select id="feedback-status" class="input" name="status">
            <option value="all" <%= status === 'all' ? 'selected' : '' %>>All</option>
            <option value="unread" <%= status === 'unread' ? 'selected' : '' %>>Unread</option>
            <option value="read" <%= status === 'read' ? 'selected' : '' %>>Read</option>
            <option value="responded" <%= status === 'responded' ? 'selected' : '' %>>Responded</option>
        </select>
        <button class="button" type="submit">Filter</button>
    </form>
</section>

<% if (selectedFeedback) { %>
    <% const item = selectedFeedback %>
    <% const status = String(item.status || 'unread').toLowerCase() %>
    <section class="panel">
        <h2>SELECTED FEEDBACK</h2>
        <article class="feedback-detail" data-feedback-id="<%= item.id %>">
            <header class="feedback-detail__header">
                <div>
                    <div class="summary">Feedback ID</div>
                    <h3 class="mono"><%= item.id %></h3>
                </div>
                <span class="chip chip--<%= status %>"><%= status === 'responded' ? 'Responded' : status === 'read' ? 'Read' : 'Unread' %></span>
            </header>

            <dl class="detail-list">
                <div><dt>Submitted</dt><dd><%= formatDate(item.timestamp) %></dd></div>
                <div><dt>From</dt><dd><%= item.username || item.userId || 'anonymous' %></dd></div>
                <div><dt>User ID</dt><dd class="mono"><%= item.userId || 'unknown' %></dd></div>
                <div><dt>Status</dt><dd><%= status %></dd></div>
            </dl>

            <section class="feedback-detail__section">
                <h4>Feedback</h4>
                <p class="feedback-detail__message"><%= item.message %></p>
            </section>

            <div class="toolbar toolbar--stacked">
                <button class="button" data-feedback-action="<%= status === 'unread' ? 'read' : 'unread' %>" data-feedback-id="<%= item.id %>" type="button"><%= status === 'unread' ? 'Mark as Read' : 'Mark as Unread' %></button>
                <button class="button button--ghost" data-feedback-action="refresh" data-feedback-id="<%= item.id %>" type="button">Refresh</button>
            </div>

            <section class="feedback-detail__section">
                <h4>Response</h4>
                <label class="stack-form">
                    <span>Write a response to the Slack user</span>
                    <textarea class="input feedback-response" id="feedback-response-<%= item.id %>" rows="8" maxlength="4000" placeholder="Type your response here"><%= item.response || '' %></textarea>
                </label>
                <div class="toolbar">
                    <button class="button" data-feedback-action="respond" data-feedback-id="<%= item.id %>" type="button">Send Response</button>
                </div>
                <% if (item.responseSentAt) { %>
                    <p class="note">Response sent at <%= formatDate(item.responseSentAt) %></p>
                <% } %>
                <% if (item.responseError) { %>
                    <p class="error"><%= item.responseError %></p>
                <% } %>
            </section>
        </article>
    </section>
<% } %>

<section class="feedback-list" id="feedback-list">
    <% (feedback || []).forEach(item => { %>
        <% const status = String(item.status || 'unread').toLowerCase() %>
        <article class="feedback-row" data-feedback-id="<%= item.id %>">
            <header><strong><%= item.username || item.userId || 'anonymous' %></strong><span><%= formatDate(item.timestamp) %></span></header>
            <p><%= item.message %></p>
            <footer>
                <span class="chip chip--<%= status %>"><%= status === 'responded' ? 'Responded' : status === 'read' ? 'Read' : 'Unread' %></span>
                <span class="mono"><%= item.id %></span>
                <div class="feedback-actions">
                    <a class="button button--ghost" href="/admin/feedback?id=<%= encodeURIComponent(item.id) %>">Open</a>
                    <button class="button" data-feedback-action="<%= status === 'unread' ? 'read' : 'unread' %>" data-feedback-id="<%= item.id %>" type="button"><%= status === 'unread' ? 'Read' : 'Unread' %></button>
                    <button class="button" data-feedback-action="respond" data-feedback-id="<%= item.id %>" type="button">Respond</button>
                    <button class="button" data-feedback-action="delete" data-feedback-id="<%= item.id %>" type="button">Delete</button>
                </div>
            </footer>
        </article>
    <% }) %>
    <% if (!(feedback || []).length) { %>
        <p>No feedback found.</p>
    <% } %>
</section>

<form method="post" action="/admin/logout" class="logout-form">
    <input type="hidden" name="csrf" value="<%= csrfToken %>" />
    <button class="button" type="submit">Logout</button>
</form>

<script type="application/json" id="admin-data"><%- serializeState({ feedback, query, status, csrfToken, selectedFeedback }) %></script>
